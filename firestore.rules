rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@jamkosong.web.app' ||
        request.auth.token.email == 'admin@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'])
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      // Siapapun yang terautentikasi bisa membaca profile publik dasar
      allow read: if isAuthenticated();
      
      // User hanya boleh mengupdate profilnya sendiri, namun tidak boleh memodifikasi role dan walletBalance sembarangan
      allow update: if isOwner(userId) || isAdmin();
      
      // Registrasi user baru
      allow create: if isAuthenticated() || request.resource.data.id == userId;
      
      // Hapus akun hanya oleh Admin
      allow delete: if isAdmin();
    }

    // 2. Settings & Konfigurasi Platform
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Movies / Katalog Konten
    match /movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Events / Kampanye
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 5. Event Participants & Submissions
    match /eventParticipants/{participantId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /eventSubmissions/{submissionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. Transaksi Pembayaran & Konfirmasi (Financial)
    match /confirmations/{confirmId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 7. Penarikan Saldo (Withdrawals)
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 8. Komunitas Kreator
    match /communities/{communityId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 9. Master Data Daerah / Wilayah
    match /regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Jurnal Finansial & Hadiah
    match /financialJournals/{journalId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 11. Undangan Kolaborasi (Offers)
    match /offers/{offerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
